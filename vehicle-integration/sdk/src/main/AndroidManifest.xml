<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      읽기·안내용 권한만 선언한다. CONTROL_* (차량 제어)는 선언하지 않는다(제동·조향 등 차량 제어 금지).
      쓰는 API 의 권한만 선언: 승인 범위 밖 권한 선언은 Pleos 앱 심사 탈락 사유 (document.pleos.ai Overview).
      실제 필요 권한은 Pleos_Connect_v2.1.0 에뮬레이터의 SecurityException 메시지와 공식 문서로 확인 (SDK_COMPATIBILITY.md).
    -->
    <!-- 기어: AAOS 표준 GEAR_SELECTION (Pleos Vehicle SDK 의 Gear API 는 deprecated) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 브레이크 페달 상태 (Pleos Vehicle SDK Brake 도메인 = CAR_DRIVE, 공식 문서 권한 표) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- protectionLevel=dangerous → 런타임 동의 필요 (MainActivity 에서 요청) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <application>
        <!-- AAOS 에만 있는 공유 라이브러리. 일반 휴대폰에서도 설치·Simulation Mode 가 되도록 required=false -->
        <uses-library android:name="android.car" android:required="false" />
    </application>
</manifest>
