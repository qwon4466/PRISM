{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prism/vehicle_frame.v1 (03 로컬 사본 — 공통 contracts/ 확정 시 그것이 최종 기준)",
  "title": "VehicleFrame v1",
  "type": "object",
  "required": ["schema_version", "timestamp_ms", "coordinate_system", "ego_id", "vehicles"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "coordinate_system": {"const": "ego_local_m"},
    "ego_id": {"type": "string", "minLength": 1},
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "vx", "vy", "heading_rad", "length_m", "width_m", "lane_id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "vx": {"type": "number"},
          "vy": {"type": "number"},
          "heading_rad": {"type": "number", "minimum": -3.14159266, "maximum": 3.14159266},
          "length_m": {"type": "number", "exclusiveMinimum": 0},
          "width_m": {"type": "number", "exclusiveMinimum": 0},
          "lane_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
